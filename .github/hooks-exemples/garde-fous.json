{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/contexte-session.cjs",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/protege-sources.cjs",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/controle-apres-ecriture.cjs",
        "timeoutSec": 15
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "matcher": "reviewer-backlog|redacteur-backlog|planificateur-backlog|controleur-backlog",
        "command": "node .github/hooks/scripts/rappel-sous-agent.cjs",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/verifier-avant-arret.cjs",
        "timeoutSec": 20
      }
    ]
  }
}
